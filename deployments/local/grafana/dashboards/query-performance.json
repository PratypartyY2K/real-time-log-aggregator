      "targets": [
        {
          "editorMode": "code",
          "expr": "1 - (sum(rate(logagg_http_requests_total{service=\"query-api\",code!~\"5..\"}[5m])) / clamp_min(sum(rate(logagg_http_requests_total{service=\"query-api\"}[5m])), 1e-9))",
